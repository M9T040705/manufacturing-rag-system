# ===== 应用配置 =====
APP_NAME=manufacturing-rag-system
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ===== 模型配置 =====
# 嵌入模型（本地路径或 HuggingFace 模型名）
EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=32

# Rerank 模型
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cuda
RERANKER_TOP_N=5

# LLM 配置（vLLM 本地部署）
LLM_MODEL_PATH=/models/Qwen2.5-14B-Instruct
LLM_API_BASE=http://localhost:8001/v1
LLM_API_KEY=EMPTY
LLM_MODEL_NAME=Qwen2.5-14B-Instruct
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9

# 云端兜底模型（DeepSeek）
CLOUD_LLM_ENABLED=true
CLOUD_LLM_API_BASE=https://api.deepseek.com/v1
CLOUD_LLM_API_KEY=your_deepseek_api_key
CLOUD_LLM_MODEL=deepseek-chat

# ===== Milvus 向量库配置 =====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=manufacturing_knowledge
MILVUS_DIM=1024
MILVUS_INDEX_TYPE=HNSW
MILVUS_METRIC_TYPE=COSINE

# ===== Redis 缓存配置 =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_TTL=3600

# ===== 文档处理配置 =====
DOCUMENT_CHUNK_SIZE=512
DOCUMENT_CHUNK_OVERLAP=64
DOCUMENT_MAX_FILE_SIZE=50MB
DOCUMENT_SUPPORTED_FORMATS=.pdf,.docx,.doc,.pptx,.txt,.png,.jpg,.jpeg

# OCR 配置
OCR_ENABLED=true
OCR_LANG=ch
OCR_USE_GPU=true

# ===== 检索配置 =====
RETRIEVAL_TOP_K=10
RETRIEVAL_SCORE_THRESHOLD=0.5
HYBRID_RETRIEVAL_WEIGHT_VECTOR=0.7
HYBRID_RETRIEVAL_WEIGHT_BM25=0.3

# ===== OA 系统对接配置 =====
OA_API_BASE=http://oa.company.com/api
OA_API_TOKEN=your_oa_token
OA_SYNC_ENABLED=true
OA_SYNC_CRON=0 2 * * *
OA_SYNC_BATCH_SIZE=100

# ===== 安全与认证 =====
JWT_SECRET_KEY=your_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_ENABLED=true

# ===== 监控配置 =====
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
